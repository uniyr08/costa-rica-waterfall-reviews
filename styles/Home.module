.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
}

/* Hero Section */
.hero {
  padding: 80px 40px;
  background: linear-gradient(135deg, #2d7a5c 0%, #1f5940 100%);
  color: white;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(242, 142, 63, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(76, 175, 80, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.heroContent {
  position: relative;
  z-index: 1;
  max-width: 800px;
  margin: 0 auto;
}

.heroTitle {
  font-size: 3.5rem;
  font-family: var(--font-display);
  margin-bottom: 16px;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.heroSubtitle {
  font-size: 1.25rem;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 48px;
  font-weight: 400;
}

/* Stats */
.statsContainer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  max-width: 500px;
  margin: 0 auto;
}

.statBox {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  padding: 24px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.statValue {
  font-size: 2.5rem;
  font-weight: 700;
  font-family: var(--font-display);
  color: #fdb44b;
  line-height: 1;
}

.statLabel {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

/* Filter Section */
.filterSection {
  padding: 48px 40px;
  background: white;
  border-bottom: 1px solid var(--border);
}

/* Loading */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  gap: 24px;
}

.spinner {
  width: 48px;
  height: 48px;
  border: 4px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading p {
  color: var(--text-light);
  font-size: 1rem;
}

/* No Results */
.noResults {
  text-align: center;
  padding: 80px 40px;
  color: var(--text-light);
}

/* Responsive */
@media (max-width: 768px) {
  .hero {
    padding: 60px 20px;
  }

  .heroTitle {
    font-size: 2.5rem;
  }

  .heroSubtitle {
    font-size: 1.05rem;
  }

  .statsContainer {
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 100%;
  }

  .statBox {
    padding: 20px;
  }

  .filterSection {
    padding: 32px 20px;
  }
}

@media (max-width: 480px) {
  .hero {
    padding: 40px 16px;
  }

  .heroTitle {
    font-size: 2rem;
  }

  .heroSubtitle {
    font-size: 1rem;
    margin-bottom: 32px;
  }

  .statValue {
    font-size: 2rem;
  }

  .filterSection {
    padding: 24px 16px;
  }
}
