import Head from 'next/head';
import { useEffect, useState } from 'react';
import { motion } from 'framer-motion';
import ReviewCard from '../components/ReviewCard';
import ReviewGrid from '../components/ReviewGrid';
import ReviewFilter from '../components/ReviewFilter';
import { supabase } from '../lib/supabase';
import styles from '../styles/home.module.css';

export default function Home() {
  const [reviews, setReviews] = useState([]);
  const [filteredReviews, setFilteredReviews] = useState([]);
  const [loading, setLoading] = useState(true);
  const [selectedTourType, setSelectedTourType] = useState('all');
  const [selectedRating, setSelectedRating] = useState('all');
  const [tourTypes, setTourTypes] = useState([]);
  const [stats, setStats] = useState({ avg: 0, total: 0 });

  useEffect(() => {
    fetchReviews();
  }, []);

  const fetchReviews = async () => {
    try {
      const { data, error } = await supabase
        .from('reviews')
        .select('*')
        .order('date', { ascending: false });

      if (error) throw error;

      setReviews(data || []);
      setFilteredReviews(data || []);

      // Extract unique tour types
      const types = ['all', ...new Set(data?.map(r => r.tour_type) || [])];
      setTourTypes(types);

      // Calculate stats
      if (data && data.length > 0) {
        const avgRating = (data.reduce((sum, r) => sum + r.rating, 0) / data.length).toFixed(1);
        setStats({ avg: avgRating, total: data.length });
      }
    } catch (error) {
      console.error('Error fetching reviews:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleFilter = (tourType, rating) => {
    setSelectedTourType(tourType);
    setSelectedRating(rating);

    let filtered = reviews;

    if (tourType !== 'all') {
      filtered = filtered.filter(r => r.tour_type === tourType);
    }

    if (rating !== 'all') {
      const ratingNum = parseInt(rating);
      filtered = filtered.filter(r => r.rating === ratingNum);
    }

    setFilteredReviews(filtered);
  };

  return (
    <>
      <Head>
        <title>Costa Rica Waterfall Tours - Customer Reviews</title>
        <meta
          name="description"
          content="Read authentic reviews from customers who've experienced Costa Rica Waterfall Tours. Exceptional guides, unforgettable adventures."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="/favicon.ico" />
        <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
      </Head>

      <main className={styles.container}>
        {/* Hero Section */}
        <motion.section
          className={styles.hero}
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ duration: 0.8 }}
        >
          <div className={styles.heroContent}>
            <motion.div
              initial={{ y: 20, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.2, duration: 0.6 }}
            >
              <h1 className={styles.heroTitle}>Guest Reviews</h1>
              <p className={styles.heroSubtitle}>Hear from adventurers who've experienced Costa Rica's waterfalls</p>
            </motion.div>

            {/* Stats */}
            <motion.div
              className={styles.statsContainer}
              initial={{ y: 20, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.4, duration: 0.6 }}
            >
              <div className={styles.statBox}>
                <div className={styles.statValue}>{stats.avg}</div>
                <div className={styles.statLabel}>Average Rating</div>
              </div>
              <div className={styles.statBox}>
                <div className={styles.statValue}>{stats.total}</div>
                <div className={styles.statLabel}>Total Reviews</div>
              </div>
            </motion.div>
          </div>
        </motion.section>

        {/* Filter Section */}
        <motion.section
          className={styles.filterSection}
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          transition={{ delay: 0.6, duration: 0.6 }}
        >
          <ReviewFilter
            tourTypes={tourTypes}
            selectedTourType={selectedTourType}
            selectedRating={selectedRating}
            onFilter={handleFilter}
          />
        </motion.section>

        {/* Reviews Grid */}
        {loading ? (
          <div className={styles.loading}>
            <div className={styles.spinner} />
            <p>Loading reviews...</p>
          </div>
        ) : (
          <ReviewGrid reviews={filteredReviews} />
        )}

        {filteredReviews.length === 0 && !loading && (
          <motion.div
            className={styles.noResults}
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
          >
            <p>No reviews found for the selected filters.</p>
          </motion.div>
        )}
      </main>
    </>
  );
}
